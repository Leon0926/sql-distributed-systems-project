@page
@model IndexModel

<h2>AppDb — Users</h2>
<table border="1" cellpadding="8">
    <tr><th>Id</th><th>Name</th><th>Email</th></tr>
    @foreach (var u in Model.Users)
    {
        <tr><td>@u.Id</td><td>@u.Name</td><td>@u.Email</td></tr>
    }
</table>

<h2>LogDb — Recent Activity</h2>
<table border="1" cellpadding="8">
    <tr><th>Id</th><th>Action</th><th>Timestamp</th></tr>
    @foreach (var l in Model.Logs)
    {
        <tr><td>@l.Id</td><td>@l.Action</td><td>@l.Timestamp</td></tr>
    }
</table>